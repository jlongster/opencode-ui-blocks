{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "lib": [
      "ESNext"
    ],
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "types": [
      "bun"
    ],
    "paths": {
      "@opentui/core": [
        "./.dev/node_modules/@opentui/core"
      ],
      "@opentui/core/*": [
        "./.dev/node_modules/@opentui/core/*"
      ],
      "@opencode/plugin": [
        "./.dev/node_modules/@opencode/plugin/src/promise/index.ts"
      ],
      "@opencode/plugin/tui": [
        "./.dev/node_modules/@opencode/plugin/src/tui/index.ts"
      ],
      "@opentui/solid": [
        "./.dev/node_modules/@opentui/solid"
      ],
      "solid-js": [
        "./.dev/node_modules/solid-js"
      ]
    },
    "typeRoots": [
      "./.dev/node_modules/@types"
    ]
  },
  "include": [
    "*.ts",
    "src",
    "test",
    "script"
  ]
}
