{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-ui-blocks",
  "version": "0.1.0",
  "description": "Interactive UI blocks for the OpenCode TUI: models write small Lua widgets in ```ui lua fences",
  "type": "module",
  "license": "MIT",
  "exports": {
    "./server": "./server.ts",
    "./tui": "./tui.js",
    "./runtime": "./src/index.ts"
  },
  "scripts": {
    "build": "bun script/build.ts",
    "dev:link": "bun script/dev-link.ts",
    "test": "bun test",
    "typecheck": "bun .dev/node_modules/@typescript/native-preview/bin/tsgo.js --noEmit"
  },
  "peerDependencies": {
    "@opencode/plugin": "*",
    "@opentui/core": ">=0.5.17"
  }
}
